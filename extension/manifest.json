{
  "manifest_version": 3,
  "key": "",
  "name": "TikTok Live Tracker",
  "version": "1.0.0",
  "description": "Track live-stream item sales, inventory, and metrics.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "identity", "downloads"],
  "host_permissions": ["https://sheets.googleapis.com/*"],
  "oauth2": {
    "client_id": "627721501298-v850an3m2mog3re717nd4kd6rnp76eh7.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tiktok.com/*"
      ],
      "js": [
        "shared/sale-parser.js",
        "shared/capture-protocol.js",
        "shared/capture-health.js",
        "capture/capture-health-reporter.js",
        "capture/capture-client.js",
        "capture/attributed-gmv-locator.js",
        "capture/bidding-variation-locator.js",
        "capture/sale-candidate-locator.js",
        "capture/capture-event-registry.js",
        "capture/capture-scheduler.js",
        "capture/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "side_panel": {
    "default_path": "tagger/sidepanel.html"
  },
  "action": {
    "default_title": "Open TikTok Live Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
