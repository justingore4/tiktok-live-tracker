{
  "manifest_version": 3,
  "name": "TikTok Live Tracker",
  "version": "0.1.0",
  "description": "Tag live-stream items as they sell and reconcile them against TikTok payment confirmations.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/event/dashboard*"
      ],
      "js": [
        "shared/sale-parser.js",
        "capture/capture-scheduler.js",
        "capture/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "side_panel": {
    "default_path": "tagger/sidepanel.html"
  },
  "action": {
    "default_title": "Open TikTok Live Tracker"
  }
}
