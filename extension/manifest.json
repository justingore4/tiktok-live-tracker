{
  "manifest_version": 3,
  "name": "TikTok Live Tracker",
  "version": "0.1.0",
  "description": "Tag live-stream items as they sell and reconcile them against TikTok payment confirmations.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": ["https://sheets.googleapis.com/*"],
  "oauth2": {
    "client_id": "627721501298-uo4j3mb29cdkhiv565hhnj62usf6ql8q.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tiktok.com/*"
      ],
      "js": [
        "shared/sale-parser.js",
        "shared/capture-protocol.js",
        "capture/capture-client.js",
        "capture/sale-candidate-locator.js",
        "capture/capture-event-registry.js",
        "capture/capture-scheduler.js",
        "capture/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "side_panel": {
    "default_path": "tagger/sidepanel.html"
  },
  "action": {
    "default_title": "Open TikTok Live Tracker"
  }
}
